    "Stories": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ঘটনা"
          }
        }
      }
    },
    "Stories and explanations are taken from the sources we name. They are for learning and reminding, not religious rulings. For a ruling, ask a qualified scholar.": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ঘটনা ও ব্যাখ্যা আমাদের উল্লেখ করা উৎস থেকে নেওয়া। এগুলো শেখা ও স্মরণ করিয়ে দেওয়ার জন্য, শরয়ি বিধান নয়। বিধান জানতে যোগ্য আলেমকে জিজ্ঞাসা করুন।"
          }
        }
      }
    },
