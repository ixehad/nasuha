    "Alhamdulillah. Pick new topics, or at your next reminder we start again from the first ayah.": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আলহামদুলিল্লাহ। নতুন বিষয় বেছে নিন, অথবা পরের রিমাইন্ডার থেকে আমরা আবার প্রথম আয়াত থেকে শুরু করব।"
          }
        }
      }
    },
