    },
    "Tap Report a mistake. We fix it in the next update, in sha Allah.": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "\"ভুল জানান\"-এ চাপুন। ইনশাআল্লাহ পরের আপডেটে আমরা ঠিক করব।"
          }
        }
      }
    },
    "Tap an hour on the clock, then pick minutes.": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ঘড়িতে একটি ঘণ্টায় চাপুন, তারপর মিনিট বেছে নিন।"
          }
        }
      }
    },
    "Taqwa": {
      "extractionState": "manual",
      "localizations": {
