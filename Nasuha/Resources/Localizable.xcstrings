      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আল্লাহই ভালো জানেন। আমাদের যেকোনো ভুল আল্লাহ ক্ষমা করুন।"
