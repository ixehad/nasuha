          }
        }
      }
    },
    "You never sign up. We do not collect your name, email, location or how you use the app. There are no ads and no analytics.": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আপনাকে কখনো নিবন্ধন করতে হয় না। আমরা আপনার নাম, ইমেইল, অবস্থান বা অ্যাপ ব্যবহারের তথ্য সংগ্রহ করি না। কোনো বিজ্ঞাপন বা অ্যানালিটিক্স নেই।"
          }
        }
      }
    },
    "You read every ayah in %@.": {
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আপনি %@ বিষয়ের সব আয়াত পড়েছেন।"
          }
        }
      }
    },
    "You read today's ayah and its story.": {
